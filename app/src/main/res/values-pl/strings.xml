    <!-- Help & Tutorial Dialog -->
    <string name="help_dialog_title">Jak działa NetMuzzle?</string>
    <string name="help_section_modes_title">Trzy tryby w kapsule aplikacji:</string>
    <string name="help_mode_allow_title">🌐 Zezwalaj (Bypass)</string>
    <string name="help_mode_allow_desc">Aplikacja łączy się bezpośrednio z internetem bez udziału ochrony.</string>
    <string name="help_mode_adblock_title">🛡️ Tylko Ads (Game Shield)</string>
    <string name="help_mode_adblock_desc">Tryb stworzony dla gier! Ruch gry (multiplayer, logowanie) leci bezpośrednio z zerowym opóźnieniem, a domeny reklamowe (Unity, AdMob itp.) są wycinane.</string>
    <string name="help_mode_fullblock_title">🚫 Kaganiec (Blackhole)</string>
    <string name="help_mode_fullblock_desc">Całkowite odcięcie aplikacji od internetu. 0% baterii, bezkompromisowa blokada.</string>
    <string name="help_section_rewards_title">🎁 Reklamy z nagrodą (Rewarded Ads):</string>
    <string name="help_section_rewards_desc">Chcesz dostać bonusowe monety za wideo? Kliknij ikonę filtrów na górze i odznacz sieć (np. Unity Ads). Nagrody zaczną działać, a inne wyskakujące reklamy pozostaną zablokowane!</string>
    <string name="help_section_battery_title">⚡ Zero drenażu baterii:</string>
    <string name="help_section_battery_desc">Gry pobierają gigabajty danych bezpośrednio przez Wi-Fi/LTE. Nasz tunel sprawdza tylko małe zapytania o adresy (DNS).</string>
