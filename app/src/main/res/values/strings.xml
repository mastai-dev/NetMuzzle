    <!-- Help & Tutorial Dialog -->
    <string name="help_dialog_title">How NetMuzzle Works</string>
    <string name="help_section_modes_title">Three modes in the app capsule:</string>
    <string name="help_mode_allow_title">🌐 Allow (Bypass)</string>
    <string name="help_mode_allow_desc">The app connects directly to the internet without any firewall intervention.</string>
    <string name="help_mode_adblock_title">🛡️ Block Ads (Game Shield)</string>
    <string name="help_mode_adblock_desc">Designed for games! Game data (multiplayer, login) flows directly with zero lag, while ad networks (Unity, AdMob, etc.) are filtered out.</string>
    <string name="help_mode_fullblock_title">🚫 Muzzle (Blackhole)</string>
    <string name="help_mode_fullblock_desc">Complete disconnection from the internet. Zero battery drain, uncompromising blocking.</string>
    <string name="help_section_rewards_title">🎁 Video Rewards (Rewarded Ads):</string>
    <string name="help_section_rewards_desc">Want in-game rewards for watching an ad? Tap the filter icon at the top and unblock the network (e.g. Unity Ads). Rewards will work while annoying pop-ups remain blocked!</string>
    <string name="help_section_battery_title">⚡ Zero Battery Drain:</string>
    <string name="help_section_battery_desc">Heavy game downloads bypass the VPN at the Linux kernel level. Our tunnel only checks tiny domain name queries (DNS).</string>

